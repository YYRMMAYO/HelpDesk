<UserControl x:Class="HelpDesk.Plugins.SystemCleaner.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- 临时文件清理 -->
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="临时文件清理" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock x:Name="TempStatus" Text="检测中..." FontSize="13" HorizontalAlignment="Right" Foreground="#64748B"/>
                    </DockPanel>
                    
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="可清理空间" FontSize="13" Foreground="#64748B"/>
                            <TextBlock x:Name="TempSize" Text="--" FontSize="28" FontWeight="Bold" Foreground="#F59E0B"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="📁" FontSize="40" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <Button Content="清理临时文件" Click="CleanTempFiles_Click"
                            Background="#F59E0B" Foreground="White" BorderThickness="0"
                            Padding="16,8" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
            
            <!-- 磁盘信息 -->
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="磁盘信息" FontSize="16" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>
                    <TextBlock Text="扫描临时文件夹以查看可释放的空间" FontSize="13" Foreground="#64748B"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
